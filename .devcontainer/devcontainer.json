{
  "name": "Beekeeper App",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [8081, 19000, 19001, 19002],
  "portsAttributes": {
    "8081": { "label": "Metro Bundler", "onAutoForward": "silent", "visibility": "public" },
    "19000": { "label": "Expo Go", "onAutoForward": "notify", "visibility": "public" },
    "19001": { "label": "Expo (LAN)", "onAutoForward": "silent", "visibility": "public" },
    "19002": { "label": "Expo DevTools", "onAutoForward": "silent", "visibility": "public" }
  },
  "postCreateCommand": "npm install"
}
